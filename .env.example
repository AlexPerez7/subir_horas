# Copia este archivo como ".env" (mismo nivel que backend_odoo.py) y
# completa con tus valores reales. El .env nunca se sube a git.

ODOO_URL=https://www.assertiva.biz/jsonrpc
ODOO_DB=tu-base-de-datos-odoo
ODOO_UID=429
ODOO_TOKEN=tu-token-de-api

# Cadena larga y aleatoria para firmar los tokens de login.
# Generarla, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria

# Postgres de Supabase - guarda usuarios, auditoría y vínculos de Telegram
# (reemplaza al usuarios.db local de versiones anteriores). Usar la cadena
# del "Transaction pooler" de Supabase (Project Settings → Database →
# Connection string → Transaction, puerto 6543) y NO la de conexión
# directa - esa requiere IPv6 de salida, que no todos los hosts soportan
# de forma confiable. Ver README, "Configurar Supabase".
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:tu-password@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Horas de vigencia del token de login antes de que haya que volver a
# loguearse (opcional, default 8).
SESSION_LIFETIME_HORAS=8

# Orígenes permitidos por CORS, separados por coma. Debe incluir la
# URL exacta de tu sitio de GitHub Pages (protocolo + dominio, SIN la
# ruta del repo ni barra final - ej. https://tu-usuario.github.io).
FRONTEND_ORIGINS=https://tu-usuario.github.io

# Opcional: si las tres están definidas, el backend crea este usuario
# admin solo al arrancar (si todavía no existe) - evita tener que
# loguearte a la VM para correr crear_usuario.py a mano solo para el
# primer admin. Ver README, "Gestión de usuarios".
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TARJETA=

# Opcional: habilita GET /api/recordatorio-cron (protegido por este
# secreto en el header X-Cron-Secret, no por login) para que un job
# automático (ver .github/workflows/recordatorio-telegram.yml) pueda
# preguntar si falta cargar horas sin necesitar una sesión de usuario.
# Generarlo igual que SECRET_KEY. El mismo valor va como secret
# CRON_SECRET en GitHub (Settings → Secrets and variables → Actions).
CRON_SECRET=

# Opcional: habilitan el bot interactivo de Telegram (podés preguntarle
# cosas como "¿qué días no he subido horas?" o "resumen de la
# semana") vía POST /api/telegram-webhook. Necesitás las dos para que
# funcione. Cada cuenta de la app se vincula a su propio chat con
# /vincular <usuario> <contraseña> - no hace falta TELEGRAM_CHAT_ID acá
# (esa variable la siguen necesitando, por separado, los workflows de
# GitHub Actions de recordatorio y resumen semanal - se configura como
# secret en GitHub, no en este .env). Ver README, "Recordatorio y
# resumen por Telegram".
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
